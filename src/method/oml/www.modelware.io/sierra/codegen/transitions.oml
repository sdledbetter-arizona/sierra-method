description <https://www.modelware.io/sierra/codegen/transitions#> as transitions {

    uses <http://opencaesar.io/codegen#> as codegen

    instance TransitionsSpec : codegen:Spec [
         codegen:construct """
            PREFIX oml:       <http://opencaesar.io/oml#>
            PREFIX codegen:   <http://opencaesar.io/codegen#>
            PREFIX base:      <https://www.modelware.io/sierra/base#>
            PREFIX state:     <https://www.modelware.io/sierra/state#>
            PREFIX xst:       <https://mozilla.github.io/nunjucks#>
            PREFIX templates: <https://www.modelware.io/sierra/codegen/transitions#>

            CONSTRUCT {
                ?file a codegen:File ;
                    codegen:path ?path ;
                    codegen:template templates:TransitionsTemplate ;
                    codegen:root ?machine .

                ?machine a xst:Machine ;
                    xst:id ?machineName ;
                    xst:state ?state ; .

                ?state a xst:State ;
                    xst:name ?stateName ;
                    xst:on ?transition .

                ?transition a xst:Transition ;
                    xst:source ?state ;
                    xst:target ?targetName ;
                    xst:event ?eventName .
            }
            WHERE {
                ?machine a state:StateMachine .

                BIND(REPLACE(STR(?machine), "^.*[/#]", "") AS ?machineName)
                BIND(IRI(CONCAT("urn:file:xstate:", ?machineName)) AS ?file)
                BIND(CONCAT("${path}/", ?machineName, "-transitions.md") AS ?path)


                OPTIONAL {
                    ?state a state:State ;
                           base:isContainedBy ?machine .
                    BIND(REPLACE(STR(?state), "^.*[/#]", "") AS ?stateName)

                    # Transitions nested inside state to avoid cross-join
                    OPTIONAL {
                        ?transition a state:Transition ;
                                    oml:hasSource ?state ;
                                    oml:hasTarget ?target .
                        BIND(REPLACE(STR(?target), "^.*[/#]", "") AS ?targetName)
                        
                        OPTIONAL {
                            ?transition state:isTriggeredBy ?event .
                            BIND(REPLACE(STR(?event), "^.*[/#]", "") AS ?eventName)
                        }
                    }
                }

            }
        """
        codegen:parameter "path"
    ]

    instance TransitionsTemplate : codegen:Template [
        codegen:body """

            {%- set statemachine = object(file, "codegen:root") -%}
            {%- set states = objects(statemachine, "xst:state") %}

            # {{ object(statemachine, "xst:id") }} Transition Table

            This table contains the transitions for the state machine, including the source state, triggering event, and target state
            
            | Source State | Event | Target State |
            |--------------|-------|--------------|
            {%- for state in states %}
            {%- set transitions = objects(state, "xst:on") %}
            {%- for t in transitions %}
            | {{ object(state, "xst:name") }} | {{ object(t, "xst:event") or "(unspecified)" }} | {{ object(t, "xst:target") }} |
            {%- endfor %}
            {%- endfor %}

        """
    ]
}
